{
  "name": "cueweave",
  "version": "0.1.0",
  "private": true,
  "description": "Weave fragmented YouTube captions into fluent bilingual subtitles.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "zip": "wxt zip",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "fixture:youtube": "node scripts/fetch-youtube-fixture.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run format:check && npm run typecheck && npm run lint && npm run test && npm run build",
    "postinstall": "wxt prepare"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/chrome": "^0.1.32",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@wxt-dev/module-react": "^1.2.2",
    "eslint": "^9.35.0",
    "fake-indexeddb": "^6.2.5",
    "prettier": "^3.6.2",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.42.0",
    "vitest": "^4.1.11",
    "wxt": "^0.21.4"
  }
}
