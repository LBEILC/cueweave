{
  "name": "cueweave",
  "version": "0.1.0",
  "private": true,
  "description": "Weave fragmented YouTube captions into fluent bilingual subtitles.",
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "dev": "npm run dev --workspace @cueweave/extension",
    "dev:desktop": "npm run dev --workspace @cueweave/desktop",
    "build:desktop": "npm run build --workspace @cueweave/desktop",
    "start:desktop": "npm run start --workspace @cueweave/desktop",
    "test:desktop:smoke": "npm run test:smoke --workspace @cueweave/desktop",
    "test:desktop:project": "npm run test:project --workspace @cueweave/desktop",
    "pack:desktop": "npm run pack:dir --workspace @cueweave/desktop",
    "dist:desktop": "npm run dist:win --workspace @cueweave/desktop",
    "test:desktop:d0": "npm run test:d0 --workspace @cueweave/desktop",
    "test:desktop:links": "npm run test:links --workspace @cueweave/desktop",
    "test:desktop:installer": "npm run test:installer --workspace @cueweave/desktop",
    "preview:ui": "node scripts/preview-ui.mjs",
    "build": "npm run build --workspace @cueweave/extension",
    "zip": "npm run zip --workspace @cueweave/extension",
    "typecheck": "npm run typecheck --workspace @cueweave/core && npm run typecheck --workspace @cueweave/extension && npm run typecheck --workspace @cueweave/desktop && tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "fixture:youtube": "node scripts/fetch-youtube-fixture.mjs",
    "eval:translate": "tsx scripts/evaluate.ts run",
    "eval:report": "tsx scripts/evaluate.ts report",
    "eval:compare": "tsx scripts/evaluate.ts compare",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run format:check && npm run typecheck && npm run lint && npm run test && npm run build && npm run build:desktop",
    "postinstall": "npm run prepare:types --workspace @cueweave/extension"
  },
  "devDependencies": {
    "@cueweave/core": "0.1.0",
    "@eslint/js": "^9.35.0",
    "@types/node": "^26.4.1",
    "esbuild": "^0.28.2",
    "eslint": "^9.35.0",
    "fake-indexeddb": "^6.2.5",
    "prettier": "^3.6.2",
    "tsx": "^4.23.13",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.42.0",
    "vitest": "^4.1.11"
  }
}
