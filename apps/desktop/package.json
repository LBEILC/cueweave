{
  "name": "@cueweave/desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "author": "CueWeave contributors",
  "description": "CueWeave Electron desktop application workspace",
  "main": "dist/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test:smoke": "npm run build && node scripts/smoke.mjs",
    "test:project": "npm run build && node scripts/project-storage-check.mjs && node scripts/project-acceptance.mjs",
    "rebuild:native": "electron-builder install-app-deps",
    "pack:dir": "npm run build && electron-builder --win --x64 --dir",
    "dist:win": "npm run build && electron-builder --win --x64",
    "test:d0": "node scripts/d0-acceptance.mjs",
    "test:links": "node scripts/link-acceptance.mjs",
    "test:installer": "node scripts/installer-acceptance.mjs"
  },
  "dependencies": {
    "@cueweave/core": "0.1.0",
    "better-sqlite3": "^13.0.3"
  },
  "devDependencies": {
    "@derhuerst/ffprobe-static": "5.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "@types/better-sqlite3": "^7.6.13",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "44.1.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "ffmpeg-static": "5.3.0",
    "playwright": "^1.62.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "vite": "^7.0.0"
  }
}
